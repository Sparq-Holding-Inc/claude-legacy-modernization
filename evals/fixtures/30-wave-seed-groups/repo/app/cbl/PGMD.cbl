       IDENTIFICATION DIVISION.
       PROGRAM-ID. PGMD.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT INFILE-FILE ASSIGN TO INFILE.
           SELECT OUTFILE-FILE ASSIGN TO OUTFILE.
       DATA DIVISION.
       FILE SECTION.
       FD  INFILE-FILE.
       01  INFILE-REC             PIC X(80).
       FD  OUTFILE-FILE.
       01  OUTFILE-REC             PIC X(80).
       PROCEDURE DIVISION.
           OPEN INPUT INFILE-FILE.
           OPEN OUTPUT OUTFILE-FILE.
           READ INFILE-FILE.
           WRITE OUTFILE-REC.
           CLOSE INFILE-FILE.
           CLOSE OUTFILE-FILE.
           GOBACK.
