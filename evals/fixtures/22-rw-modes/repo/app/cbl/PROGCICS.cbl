       IDENTIFICATION DIVISION.
       PROGRAM-ID. PROGCICS.
       PROCEDURE DIVISION.
           EXEC CICS READ FILE('RWFILE') INTO(REC) UPDATE END-EXEC.
           EXEC CICS REWRITE FILE('RWFILE') FROM(REC) END-EXEC.
           EXEC CICS STARTBR FILE('BRFILE') RIDFLD(K) END-EXEC.
           EXEC CICS READNEXT FILE('BRFILE') INTO(REC)
                RIDFLD(K) END-EXEC.
           EXEC CICS ENDBR FILE('BRFILE') END-EXEC.
           EXEC CICS DELETE FILE('DELFILE') END-EXEC.
           EXEC CICS RETURN END-EXEC.
