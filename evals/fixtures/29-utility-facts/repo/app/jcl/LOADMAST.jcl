//LOADMAST JOB (ACCT),'LOAD',CLASS=A
//S1       EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//INFILE   DD DSN=SPARQ.TEST.FLAT,DISP=SHR
//OUTFILE  DD DSN=SPARQ.TEST.MASTER,DISP=OLD
//SYSIN    DD *
  DELETE SPARQ.TEST.MASTER -
    CLUSTER
  DEFINE CLUSTER (NAME(SPARQ.TEST.MASTER) -
    INDEXED)
  REPRO INFILE(INFILE) OUTFILE(OUTFILE)
/*
