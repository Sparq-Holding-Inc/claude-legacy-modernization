//DSNJOB   JOB (ACCT),'DSN',CLASS=A
//S1       EXEC PGM=SORT
//SORTIN   DD DSN=SPARQ.GDG.BASE(0),DISP=SHR
//SORTOUT  DD DSN=SPARQ.GDG.BASE(+1),DISP=(NEW,CATLG)
//SYSIN    DD DSN=SPARQ.CNTL(SORTCARD),DISP=SHR
//WORK     DD DSN=&&TEMP,DISP=(NEW,PASS)
//DUMMYDD  DD DUMMY
//NULLDD   DD DSN=NULLFILE
//SYSOUT   DD SYSOUT=*
